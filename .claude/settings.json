{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/git-guard/sync-main.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/git-guard/check-freshness.sh\" warn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/git-guard/assert-not-main.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/git-guard/deny-assets.sh\" staged"
          }
        ]
      }
    ]
  }
}
