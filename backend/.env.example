# Copy to .env.development (local) and .env.production (deploy).
# Postgres everywhere — Prisma provider is locked to postgresql.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml defaults (fall/fall, db fall_dev).
DATABASE_URL="postgresql://fall:fall@localhost:5432/fall_dev?schema=public"

# ML serving endpoint the backend calls for inference.
ML_SERVING_URL="http://localhost:8000"
ML_SERVING_TIMEOUT_MS=3000

# Trusted pilot/edge alert ingress. Set a real secret only in local/prod env files.
ALERT_EVENTS_API_KEY="replace-with-local-secret"
ALERT_POLICY_ENABLED=true
ALERT_COOLDOWN_SEC=60
ALERT_HOURLY_CAP=10

# Kakao send-to-me remains a pilot adapter behind ChannelPort.
KAKAO_TOKEN_PATH="var/kakao-token.json"
KAKAO_MESSAGE_ENDPOINT="https://kapi.kakao.com/v2/api/talk/memo/default/send"
KAKAO_MESSAGE_LINK_URL="http://localhost:3000"
KAKAO_REQUEST_TIMEOUT_MS=3000
