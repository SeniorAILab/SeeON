# Copy to .env.development (local) — tracked template, never commit real secrets.
# Postgres everywhere — Prisma provider is locked to postgresql (ADR-002).
#
# DB role separation (ADR-A / NR1):
#   DATABASE_URL  = fall_app (NOSUPERUSER NOBYPASSRLS) — application runtime
#   DIRECT_URL    = fall     (superuser)               — migrations + seed only
#
# First-time setup:
#   1. docker compose down -v   # wipe old volume so initdb scripts run
#   2. docker compose up -d db  # creates fall_app role via init SQL
#   3. pnpm --filter backend prisma:migrate  # applies schema + RLS
#   4. pnpm --filter backend prisma:seed     # inserts demo org / residents

NODE_ENV=development
# Standard service port map (root .env.example is the canonical SSOT):
#   front 3000 · backend 8080 · ml-serving 8000 · db 5432
PORT=8080

# CORS allow-origin for the Next.js frontend (browser-facing localhost).
FRONT_ORIGIN=http://localhost:3000

# ── Application runtime role (NOSUPERUSER NOBYPASSRLS) ───────────────────────
DATABASE_URL="postgresql://fall_app:fall_app@localhost:5432/fall_dev?schema=public"

# ── Privileged role for migrations / seed (superuser) ───────────────────────
DIRECT_URL="postgresql://fall:fall@localhost:5432/fall_dev?schema=public"

# ── ML serving endpoint (native localhost; compose injects http://ml-serving:8000) ──
ML_SERVING_URL="http://localhost:8000"

# ── Auth ────────────────────────────────────────────────────────────────────
# KakaoClient validates KAKAO_REST_API_KEY + KAKAO_REDIRECT_URI at boot
# (onModuleInit), so the backend will NOT start without them. The values below
# are DEV PLACEHOLDERS that only satisfy boot validation — replace with real
# Kakao OAuth credentials before exercising the login flow, and set a strong
# random SESSION_JWT_SECRET (>=32 chars) in any shared/prod environment.
SESSION_JWT_SECRET=dev-only-session-secret-change-me-32chars-min
# SESSION_TTL_SECONDS=1800
# SESSION_REFRESH_WINDOW_SECONDS=600
KAKAO_REST_API_KEY=dev-placeholder-kakao-rest-api-key
# KAKAO_CLIENT_SECRET=
# Kakao redirects to the backend callback route (served on :8080).
KAKAO_REDIRECT_URI=http://localhost:8080/auth/kakao/callback
# KAKAO_TOKEN_PATH=./var/kakao-token.json

# ── Demo ingest keys (fill in for Phase 3/5 — same HMAC contract as prod) ───
# DEMO_INGEST_KEYID=demo-cam-01
# DEMO_INGEST_SECRET=change-me-demo-secret
