# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim AS dashboard-build

WORKDIR /src/ml/dashboard
RUN corepack enable
COPY ml/dashboard/package.json ml/dashboard/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm i --frozen-lockfile
COPY ml/dashboard ./
RUN pnpm build


FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

COPY ml/pyproject.toml ml/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-default-groups --no-install-project

COPY ml/contracts ./contracts
COPY ml/events ./events
COPY ml/api ./api
COPY --from=dashboard-build /src/ml/dashboard/dist /app/dashboard
RUN mkdir -p /app/models/fall /app/models/pose /app/models/bed

ENV HOST=127.0.0.1 \
    PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn api.main:app --host ${HOST} --port ${PORT}"]
