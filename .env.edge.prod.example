# Edge ML production environment contract.
#
# Copy this file to .env.edge.prod on the edge device and fill real values:
#   cp .env.edge.prod.example .env.edge.prod
#
# .env.edge.prod is gitignored.

ML_SERVING_PORT=8000

# Gitignored JSON file mounted into ml-edge-worker as a Compose secret.
# It contains per-camera RTSP URLs, backend ingest endpoints, key IDs, and secrets.
EDGE_CAMERA_CONFIG=./ml/config/edge-cameras.local.json
