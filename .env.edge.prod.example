# Edge ML production environment contract.
#
# Copy this file to .env.edge.prod on the edge device and fill real values:
#   cp .env.edge.prod.example .env.edge.prod
#
# .env.edge.prod is gitignored.

# Optional host port for the edge-local ml-api loopback binding.
ML_SERVING_PORT=8000

# Gitignored per-camera YAML mounted into ml-worker as a Compose secret.
# It contains per-camera RTSP URLs, the local ml-api relay URL/token, camera
# identity, and the LSTM fall-model artifact contract (ml/config/ml-worker.example.yaml).
EDGE_CAMERA_CONFIG=./ml/config/ml-worker.local.yaml

# Backend ingest endpoints reached by ml-api from the edge device.
API_BACKEND_ALERT_URL=https://senai.example.com/ingest/alerts
API_BACKEND_HEARTBEAT_URL=https://senai.example.com/ingest/heartbeat

# Backend-issued ingest credentials used by ml-api when signing /ingest calls.
API_INGEST_KEY_ID=
API_INGEST_SECRET=

# Shared bearer token for ml-worker -> ml-api relay calls. Use the same value for
# ml-api API_EDGE_RELAY_TOKEN and the worker RELAY_TOKEN injected by Compose.
API_EDGE_RELAY_TOKEN=

# Camera-to-facility/resident binding JSON consumed by ml-api relay validation.
API_CAMERA_INVENTORY=[{"camera_id":"cam-edge-01","facility_id":"facility-prod","resident_id":"resident-prod"}]

# Optional backend ingest client timeout in seconds.
# API_BACKEND_INGEST_TIMEOUT_SEC=0.5
