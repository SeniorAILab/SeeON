# Edge ML production environment contract.
#
# Copy this file to .env.edge.prod on the edge device and fill real values:
#   cp .env.edge.prod.example .env.edge.prod
#
# .env.edge.prod is gitignored.

ML_SERVING_PORT=8000

# Optional Hugging Face deployment token for Space/image publishing workflows.
# This is not required for ordinary edge runtime.
HF_TOKEN=

# Backend ingest endpoint must be the public URL reachable from the edge device
# and must include the full /ingest/alerts path.
ALERT_API_URL=
INGEST_KEY_ID=
INGEST_SECRET=
DEMO_RESIDENT_ID=
DEMO_FACILITY_ID=
